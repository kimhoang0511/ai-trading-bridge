# ── Backend service (Railway) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/ai_bridge   # Railway Postgres plugin tự inject
SECRET_KEY=change-me-to-random-secret
CLAUDE_API_KEY=sk-ant-api03-...
CLAUDE_CHAT_MODEL=claude-haiku-4-5
CLAUDE_PARSE_MODEL=claude-sonnet-4-6
CLAUDE_CHAT_MAX_TOKENS=512
CLAUDE_PARSE_MAX_TOKENS=2000
WHITELISTED_ACCOUNTS=11997690
FRONTEND_URL=https://your-frontend.up.railway.app        # URL của frontend service

# ── Frontend service (Railway) ────────────────────────────────────────────────
# Đây là build-time ARGs — set trong Railway → Variables của frontend service
VITE_API_URL=https://your-backend.up.railway.app/api     # URL REST API của backend
VITE_WS_URL=wss://your-backend.up.railway.app            # URL WebSocket của backend
